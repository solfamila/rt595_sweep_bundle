#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
BUNDLE_ROOT=$(cd "$SCRIPT_DIR/../.." && pwd)
VENV_DIR="$BUNDLE_ROOT/.local/rt595-trace-venv"
DEFAULT_SOURCE_ROOT="/Users/foxy/intent/workspaces/hidden-gibbon/repo/src"
SOURCE_ROOT="${RT595_TRACE_SOURCE_ROOT:-$DEFAULT_SOURCE_ROOT}"
DB_PATH="$BUNDLE_ROOT/.local/rt595-trace/rt595_trace.duckdb"

detect_python() {
  if [[ -x "$VENV_DIR/bin/python" ]]; then
    printf '%s\n' "$VENV_DIR/bin/python"
    return 0
  fi

  if command -v python3 >/dev/null 2>&1; then
    command -v python3
    return 0
  fi

  if command -v python >/dev/null 2>&1; then
    command -v python
    return 0
  fi

  echo "python interpreter not found for rt595-trace" >&2
  return 1
}

find_site_packages() {
  find "$VENV_DIR/lib" -maxdepth 2 -type d -name site-packages 2>/dev/null | head -n 1
}

PYTHON_BIN=$(detect_python)
SITE_PACKAGES=$(find_site_packages || true)

if [[ ! -d "$SOURCE_ROOT/rt595_trace" ]]; then
  echo "missing rt595-trace source tree under $SOURCE_ROOT" >&2
  echo "Set RT595_TRACE_SOURCE_ROOT if the hidden-gibbon repo lives somewhere else." >&2
  exit 1
fi

if [[ ! -f "$DB_PATH" ]]; then
  echo "missing rt595-trace database at $DB_PATH" >&2
  exit 1
fi

export PYTHONPATH="$SOURCE_ROOT${SITE_PACKAGES:+:$SITE_PACKAGES}${PYTHONPATH:+:$PYTHONPATH}"

if [[ $# -eq 0 ]]; then
  set -- serve --db "$DB_PATH"
fi

exec "$PYTHON_BIN" -m rt595_trace.cli "$@"