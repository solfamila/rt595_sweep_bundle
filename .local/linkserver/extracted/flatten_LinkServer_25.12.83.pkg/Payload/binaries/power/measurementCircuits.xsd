<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
 Copyright 2020-2021 NXP
 --><xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" attributeFormDefault="unqualified" elementFormDefault="qualified">
	<xs:simpleType name="sourceName">
		<xs:annotation>
			<xs:documentation>VDD/CURR source type.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Target voltage"/>
			<xs:enumeration value="Target current"/>
			<xs:enumeration value="Shield current"/>
			<xs:enumeration value="Power"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="sourceType">
		<xs:annotation>
			<xs:documentation>A vdd/current source channel.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element maxOccurs="1" minOccurs="1" name="id" type="xs:int"/>
			<xs:element maxOccurs="1" minOccurs="1" name="name" type="sourceName"/>
			<xs:element maxOccurs="1" minOccurs="1" name="unit" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="circuits">
		<xs:complexType>
		<xs:sequence>
			<xs:element maxOccurs="unbounded" name="circuit">
				<xs:complexType>
				<xs:sequence>
					<xs:element name="targetResistors">
						<xs:complexType>
						<xs:sequence>
							<xs:element maxOccurs="unbounded" minOccurs="1" name="resistor" type="xs:double"/>
						</xs:sequence>
						</xs:complexType>
					</xs:element>
					<xs:element name="shieldResistor" type="xs:double"/>
					<xs:element name="voltageGain" type="xs:double"/>
					<xs:element name="vRef" type="xs:double"/>
					<xs:element name="bitLevelADC" type="xs:int"/>
					<xs:element name="sources" minOccurs="1">
						<xs:complexType>
						<xs:sequence>
							<xs:element maxOccurs="unbounded" minOccurs="1" name="source" type="sourceType"/>
						</xs:sequence>
						</xs:complexType>
					</xs:element>
				</xs:sequence>
				<xs:attribute name="name" type="xs:string"/>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
