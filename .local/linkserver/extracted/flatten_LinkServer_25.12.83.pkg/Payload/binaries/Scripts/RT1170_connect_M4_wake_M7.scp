100  REM =======================================================================
110  REM RT1170_connect_M4_wake_M7.scp
120  REM (use only when M4 is configured as boot core)
150  REM =======================================================================
160  PRINT "RT1170 Connect M4 and Wake M7 Script"
170  REM =======================================================================
180  REM Uncomment ProbeList for standalone script use (outside the stub)
190  REM =======================================================================
200  REM ProbeList
210  p% = ProbeFirstFound
220  REM ProbeOpenByIndex p%
230  WireSwdConnect p%
240  SelectProbeCore p% 1
250  CMInitApDp this
252  REM =======================================================================
254  REM Disable ECC
256  GOSUB 1500
260  REM =======================================================================
270  REM The M7 AP is not visible while the core is held in reset
280  REM Prepare a spin code in RAM and wake up / reset the M7 to it
290  REM This enables the M7 AP, required for debug visibility
300  REM =======================================================================
330  REM Prepare spin code
340  GOSUB 1000
350  REM =======================================================================
360  PRINT "Setting M7 clock"
370  REM Set m7_clk_root to OSC_RC_48M / 2: CLOCK_ROOT0 = mux(0), div(1)
380  Poke32 this 0x40CC0000 0x001
390  PRINT "Resetting M7 core"
400  REM Save current reset SRMR and prevent M7 SW reset affecting the system
410  s% = Peek32 this 0x40C04004
420  Poke32 this 0x40C04004 0x00003000
430  Poke32 this 0x40C042A4 0x1
440  Poke32 this 0x40C04004 s%
450  REM =======================================================================
460  REM Release M7 if needed
500  s% = Peek32 this 0x40c04000
510  IF s% & 2 == 2 THEN GOTO 560
520  PRINT "Releasing M7"
530  s% = s% | 2
540  Poke32 this 0x40c04000 s%
550  REM =======================================================================
560  PRINT "View cores on the DAP AP"
570  WireSwdConnect p%
580  CoreList p%
590  SelectProbeCore p% 1
600  REM =======================================================================
610  REM Potentially FlexRAM might need to be set to ensure TCMs are available
620  REM Uncomment next line if needed
630  REM GOSUB 800
640  REM =======================================================================
650  REM Finished - 0 to select the M7, 1 to select M4
660  d% = 1
670  REM =======================================================================
680  REM Setup VTOR in preparation for VECTRESET
690  GOSUB 1300
700  REM =======================================================================
710  END
800  REM ====================== SUB: Configure FlexRAM ========================
810  PRINT "Configuring FlexRAM for 256KB I-TCM, 256KB D-TCM, 0KB OCRAM"
820  REM FlexRAM TCM_CTRL - force RAM clocking ON and set fast mode = b100
830  Poke32 this 0x40028000 0x4
840  REM IOMUXC_GPR17/18 FlexRAM 32KB banks allocation - I(b11), D(b10), OC(b01)
850  Poke32 this 0x400E4044 0x0000AAFF
860  Poke32 this 0x400E4048 0x0000AAFF
870  REM IOMUXC_GPR16 Enable FLEXRAM_BANK_CFG in GPR16/17
880  s% = Peek32 this 0x400E4040
890  s% = s% | 4
900  Poke32 this 0x400E4040 s%
910  RETURN
1000 REM ==================== SUB: Set up M7 spin code ========================
1010 REM Setup some spin code into an area of OCRAM1 (0x2024FF00)
1020 REM Condensed vector table format taking up 2 words of memory:
1030 REM   - x00: SP (dummy), two back-to-back branch-to-self opcodes (b 0)
1040 REM   - x04: PC - points to address x00 (+1 Thumb)
1050 PRINT "Setting M7 spin code"
1060 Poke32 this 0x2024FF00 0xE7FEE7FE
1070 Poke32 this 0x2024FF04 0x2024FF01
1180 REM Set addr >> 7 into CM7 VTOR iomuxc_lpsr_GPR26 (RevB) or 0x400e404c (Rev A)
1190 v% = Peek32 this 0x40C84800
1200 IF v% & 0x00FFFFF0 == 0x1170A0 Then GOTO 1230
1210 Poke32 this 0x40C0C068 0x4049FE
1220 RETURN
1230 Poke32 this 0x400E404C 0x4049FE
1240 RETURN
1300 REM ============== SUB: Setup CM4 VTOR iomuxc_lpsr_GPR0/1 =================
1310 REM After VECTRESET, VTOR alaways ends up with value 0x0.
1320 REM But if the address represented by iomuxc_lpsr_GPR0/1 is invalid,
1330 REM a hard fault occurs after VECTRESET. These registers are set in
1340 REM preparation for a pre-flash driver VECTRESET requested by the stub.
1350 REM BootROM VTOR
1360 s% = 0x210000
1370 REM Set top/bottom 16 bits of VTOR address into CM4 VTOR iomuxc_lpsr_GPR0/1
1380 Poke32 this 0x40C0C000 s% & 0xffff
1390 Poke32 this 0x40C0C004 s% >> 16
1400 RETURN
1410 REM =======================================================================
1500 REM ====================== SUB: Disable M4 TCM ECC and OCRAM ECC ==========
1510 REM MECC1/2 PIPE_ECC_EN - disable ECC
1520 Poke32 this 0x40014100 0x00000000
1530 Poke32 this 0x40018100 0x00000000
1540 REM LMDR0/1/2/3 CF0 - disable ECC
1550 Poke32 this 0xE0080400 0x00000000
1560 Poke32 this 0xE0080404 0x00000000
1570 Poke32 this 0xE0080408 0x00000000
1580 Poke32 this 0xE008040C 0x00000000
1590 RETURN