100   REM ================================================================
110   REM PN7642_reset.scp
150   REM ================================================================
160   Print "PN7642 Reset Script"

165   p% = ProbeFirstFound

170   REM If VTOR is not in RAM (0x20003000-0x20008600) ranges do a SYSRESET
180   IF (d% < 0x20003000) || (d% >= 0x20008600) Then GOTO 270

190   REM RAM-based application - perform a SOFT reset
200   PRINT "SOFT Reset (RAM)"
210   b% = Peek32 This d%
220   t% = d% + 4
230   a% = Peek32 This t%
240   c% = 0x01000000
245   Print "PC=" ~a%
250   Print "SP=" ~b%
255   Print "VTOR=" ~d%
260   End

270   Cmhalt this
275   SelectProbeCore p% 0

280   REM Try to stop execution before ResetISR
300   REM Set breakpoint at ResetISR
310   r% = peek32 this 0x208004
320   If (r% < 0x208000) || (r% > 0x234FFF) Then Goto 340
330   Cmbreakset this r%
335   REM BootROM jumps to this address if no valid firmware
340   Cmbreakset this 0x20003002
350   Print "Breakpoints before reset"
360   Cmbreaklist this
370   Print "Sending CMSYSRESETREQ"
372   x% = WireGetSpeed p%
374   WireSetSpeed p% 1000
380   Cmsysresetreq this
382   WireSetSpeed p% x%
390   WireSwdConnect this
400   Print "Registers after CMSYSRESETREQ"
410   Cmregs this

470   REM Call PN76_Sys_Hal_SoftReset(1);
480   REM bx r12
490   Poke16 this 0x20003100 0x4760
500   Cmwritereg this 0 1
510   Cmwritereg this 12 0x00200869
520   Cmwritereg this 15 0x20003100
522 x% = WireGetSpeed p%
524 WireSetSpeed p% 1000

530   Cmrun this
540   Wireswdconnect p%
542   WireSetSpeed p% x%
550   Print "After PN76_Sys_Hal_SoftReset(1)"
560   Cmregs this

570   Cmbreakclear this r%
580   Cmbreakclear this 0x20003002
630   End
