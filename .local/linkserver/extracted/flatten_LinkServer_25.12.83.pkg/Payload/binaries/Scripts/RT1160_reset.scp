100  REM IMXRT1160 Reset script

110  REM When RT1160 is reset via SYSRESET_REQ under debugger control, bootROM will
120  REM not boot an existent flash application, instead it will enter a debug loop at a
130  REM fixed PC address (0x00223104). The debugger then needs to initialise the execution
140  REM context in order to jump to the user application.

170  REM When a reset script is used, it overrides any other reset configuration in the IDE.
180  REM Therefore, it needs to handle the most common scenarios:
190  REM  - used post flash programming (in this case it performs a system reset)
200  REM  - used for RAM-based application (in this case it performs a soft reset)

210  REM The script is given some useful information like the current context SP (b%), PC (a%),
220  REM PSR (c%) and VTOR or image address in case of RAM applications (d%) and it passes back
230  REM updated reset context to the debugger
240  REM The vector table address is assumed 0x30002000/0x60002000 for flash images

250  REM Find the probe index
260  p% = ProbeFirstFound
265  REM Core index is expected to be already selected
270  THIS

280  REM If VTOR is in flash (0x30000000/0x60000000) or bootROM (0x00200000) ranges do a system reset
290  IF (d% & 0xFFFF0000 == 0x30000000) || (d% & 0xFFFF0000 == 0x60000000) || (d% & 0xFFFF0000 == 0x00200000) Then GOTO 400

300  REM RAM-based application - perform a SOFT reset
310  PRINT "SOFT Reset (RAM)"
320  b% = Peek32 This d%
330  t% = d% + 4
340  a% = Peek32 This t%
350  c% = 0x01000000
360  GOTO  1000

400  REM Flash application - perform SYSTEM reset (via boot core)
410  PRINT "SYSTEM Reset"
415  SelectProbeCore p% 0
420  CMResetVectorCatchSet This
422  x% = WireGetSpeed p%
424  WireSetSpeed p% 1000000
430  CMSysResetReq This
432  WireSetSpeed p% x%

440  WireSWDConnect This
450  APList This
460  CMInitApDp This
470  CMResetVectorCatchClear This

480  REM Initialise M4
490  GOSUB 2000

500  a% = CMReadReg This 15
520  v% = Peek32 This 0x40C84800

540  REM Check PC in debug loop: no special handling otherwise
550 IF (v% & 0x00FFF0F0 == 0x1160A0) && (a% != 0x00223104) || (v% & 0x00FFF0F0 >= 0x1160C0) && (a% != 0x002231FC) Then GOTO 700

600  REM Initialise reset context from vector table @ +0x2000
605  REM BOOT_CFG2[3] - FlexSPI instance (SBMR1[15:8])
610  t% = Peek32 This 0x40C04008
620  d% = 0x30000000 * (((t% & 0x00000800) >> 11) + 1) + 0x2000
630  b% = Peek32 This d%
640  a% = Peek32 This (d% + 4)
650  c% = 0x01000000
660  CMWriteReg This 13 b%
670  CMWriteReg This 15 a%
680  CMWriteReg This 16 c%
690  GOTO 1000

700  REM Use PC, SP, PSR, VTOR from target after reset
710  b% = CMReadReg This 13
720  c% = CmReadReg This 16
730  d% = Peek32 This 0xe000ed08

1000 PRINT "Vector table SP/PC is the reset context."
1010 PRINT "PC = "; ~a%
1020 PRINT "SP = "; ~b%
1030 PRINT "XPSR = "; ~c%
1040 PRINT "VTOR = "; ~d%

1050 REM Enable trace and halting debug trap on faults"
1060 z% = Peek32 this 0xE000EDFC
1070 z% = z% | 0x10007f1
1080 PRINT "Set DEMCR = " ~z%
1090 Poke32 this 0xE000EDFC z%
1100 END

2000  REM ====================SUB: Set up M4=====================================
2010  REM The M4 AP is not visible while the core is held in reset
2020  REM Prepare a spin code in RAM and wake up / reset the M4 to it
2030  REM This serves two purposes:
2040  REM   - enables the M4 AP, required for debug visibility
2050  REM   - prevents M4 code from interfering with flash programming on M7
2060  REM =======================================================================
2130  REM Prepare spin code
2140  GOSUB 2400
2150  REM =======================================================================
2160  PRINT "Setting M4 clock"
2170  REM Set m4_clk_root to OSC_RC_400M / 2: CLOCK_ROOT1 = mux(2), div(1)
2180  Poke32 this 0x40CC0080 0x201
2190  PRINT "Resetting M4 core"
2200  REM Save current reset SRMR and prevent M4 SW reset affecting the system
2210  s% = Peek32 this 0x40C04004
2220  Poke32 this 0x40C04004 0x00000C00
2230  Poke32 this 0x40C04284 0x1
2240  Poke32 this 0x40C04004 s%
2250  REM =======================================================================
2260  REM Release M4 if needed
2270  s% = Peek32 this 0x40c04000
2280  IF s% & 1 == 1 THEN GOTO 2330
2290  PRINT "Releasing M4"
2300  s% = s% | 1
2310  Poke32 this 0x40c04000 s%
2320  REM =======================================================================
2330  PRINT "View cores on the DAP AP"
2340  WireSwdConnect p%
2350  CoreList p%
2360  SelectProbeCore p% 0
2390  RETURN

2400  REM ==================== SUB: Set up M4 spin code ========================
2410  REM Setup some spin code into an area of D-TCM (0x2021FF00)
2420  REM Condensed vector table format taking up 2 words of memory:
2430  REM   - x00: SP (dummy), two back-to-back branch-to-self opcodes (b 0)
2440  REM   - x04: PC - points to address x00 (+1 Thumb)
2450  PRINT "Setting M4 spin code"
2460  Poke32 this 0x2021FF00 0xE7FEE7FE
2470  Poke32 this 0x2021FF04 0x2021FF01
2480  REM Set top/bottom 16 bits of RAM address into CM4 VTOR iomuxc_lpsr_GPR0/1
2490  Poke32 this 0x40C0C000 0xFF00
2500  Poke32 this 0x40C0C004 0x2021
2510  RETURN
