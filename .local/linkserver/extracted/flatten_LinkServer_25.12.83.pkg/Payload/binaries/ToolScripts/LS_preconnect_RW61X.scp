110  REM a% = 1
120  ProbeOpenByIndex a%
130  WireSWDConnect a%
140  REM Do nothing if chip revision is A0. (z% == 1 if Peek32 failed)
150  z% = Peek32 this 0x45001114
160  if z% != 1 && (z% & 0xFF == 0) Then End
170  WireTimedReset a% 50
175  Wait 100
180  WireSWDConnect a%
190  APList a%
200  REM -----------------------------------
210  REM Debug Mailbox AP Index is 3
220  REM -----------------------------------
230  SelectProbeCore a% 3
240  REM -----------------------------------
250  REM DEBUG_SESSION_REQ: 7
260  REM -----------------------------------
270  r% = 7
280  REM -----------------------------------
290  PRINT "Issuing Debug Session Request... ";r%
300  PRINT "";
310  DebugMailboxReq this r%
320  CoreList a%
330  REM ProbeCloseByIndex a%
340  SelectProbeCore a% 0
