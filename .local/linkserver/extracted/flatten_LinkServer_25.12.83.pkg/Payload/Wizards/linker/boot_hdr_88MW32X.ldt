<#-- Only insert header if Flash region starts at true base address -->
<#if (MemUtils.location(CODE) == Utils.strToInt("0x1F000000")) >
	/* Offset .text by 0x100 bytes. These 0x100 are to be added by mw_img_conv.exe*/
    .boot_hdr (NOLOAD) : ALIGN(${text_align})
    {
        FILL(0xFF)
        BYTE(0xFF)
        . += 0x100 - 1;
    } > ${CODE}

 </#if>